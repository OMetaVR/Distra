{
  "name": "distra",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "A Discord iOS client mod with Vendetta, Bunny, Enmity and Aliucord plugin support",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-plugins.mjs && node scripts/build.mjs",
    "build:release": "node scripts/build-plugins.mjs && node scripts/build.mjs --release",
    "build:js": "node scripts/build.mjs",
    "build:plugins": "node scripts/build-plugins.mjs",
    "bootstrap": "pnpm install && pnpm --dir builtin-plugins install",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "tweak": "pnpm build:release && make -C tweak package FINALPACKAGE=1",
    "tweak:rootless": "pnpm build:release && make -C tweak package FINALPACKAGE=1 THEOS_PACKAGE_SCHEME=rootless",
    "devtools": "node scripts/devtools.mjs"
  },
  "dependencies": {
    "spitroast": "^2.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.17",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "esbuild": "^0.25.0",
    "react-native": "0.79.2",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
